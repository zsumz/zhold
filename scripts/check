#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

python3 scripts/guardrails.py

if ! command -v cargo >/dev/null 2>&1; then
  echo "cargo is required for the full repository check" >&2
  exit 127
fi

run_cargo() {
  local subcommand="$1"
  shift
  if [[ -f Cargo.lock ]]; then
    cargo "$subcommand" --locked "$@"
  else
    cargo "$subcommand" "$@"
  fi
}

cargo fmt --all -- --check
run_cargo clippy --workspace --all-targets --all-features -- -D warnings
run_cargo test --workspace --all-features
RUSTDOCFLAGS="-D warnings" run_cargo doc --workspace --all-features --no-deps

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git diff --check
  git diff --exit-code
fi
